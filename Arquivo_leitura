#include <stdio.h>
#include <stdlib.h>
#include <conio.h>
#include <string.h>
int main()
{
  
    //criar ponteiro para a area do arquivo
    FILE *arq;
    //definir o tamanho do buffer
    char buffer[1000];
    
    //abrir o arquivo para leitura
    arq=fopen("notas001.txt","rt");
    
    //ler os dados e imprimir
    
    while(!feof(arq))
    {
        //efetuar a leitura do arquivo
        fgets(buffer,100,arq);
        printf("%s",buffer);
    }
    fclose(arq);
    printf("\nOBRIGADO PELA A UTILIZAÇÃO\n");
    
    
    
    return 0;
}
