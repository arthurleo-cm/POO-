    while(!feof(arq))
    {
        
        
        fgets(buffer,500,arq);
        tam = strlen(buffer);
        buffer[tam - 1] = '\0';
        strcpy(nome,buffer);
        fgets(buffer,500,arq);
        altura = atof(buffer);
        fgets(buffer,500,arq);
        peso = atof(buffer);
        imc = (peso / (altura * altura));
        cont;
        contpessoas++;
        printf("\nNOME: %-10s ALTURA: %7.2f   PESO: %7.2f  IMC:%7.2f",nome,altura,peso,imc);
        somaAltura = somaAltura+altura;
